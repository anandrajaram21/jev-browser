# Copy to .env and fill in the two keys. Loaded from next to package.json, from any working directory.

# TypeSafe Jev: makes every decision (https://typesafe.ai)
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
TYPESAFE_VISION_MODEL=jev-preview

# OpenRouter: writes the little text Jev can't (https://openrouter.ai)
TEXT_MODEL_API_KEY=
TEXT_MODEL_BASE_URL=https://openrouter.ai/api/v1
# Free text and answers: fastest and cheapest
TEXT_MODEL=meta-llama/llama-3.1-8b-instruct
TEXT_MODEL_REASONING=none
TEXT_MODEL_PROVIDERS=Groq
# Planning (bug report or task to steps): needs more smarts
TEXT_PLAN_MODEL=openai/gpt-oss-20b
TEXT_PLAN_PROVIDERS=Groq
TEXT_PLAN_REASONING=low

# Optional agent-browser settings, e.g. AGENT_BROWSER_HEADED=1. See `agent-browser --help`.
